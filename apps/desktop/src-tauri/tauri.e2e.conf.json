{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "e2e",
          "description": "Test-only hooks. This overlay is used only by e2e builds made with the `e2e` Cargo feature.",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-e2e-status",
            "allow-e2e-add-trade"
          ]
        }
      ]
    }
  }
}
