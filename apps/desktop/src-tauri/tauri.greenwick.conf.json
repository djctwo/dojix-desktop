{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greenwick",
  "mainBinaryName": "greenwick",
  "identifier": "io.github.djctwo.greenwick",
  "build": {
    "beforeDevCommand": "pnpm dev:greenwick",
    "beforeBuildCommand": "pnpm build:web:greenwick"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Greenwick",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0c0d0e"
      }
    ]
  },
  "bundle": {
    "shortDescription": "Stock trade journal",
    "longDescription": "Greenwick is a free, open-source stock trade journal. Your journal stays encrypted on your computer.",
    "icon": [
      "../../../brands/greenwick/icons/32x32.png",
      "../../../brands/greenwick/icons/128x128.png",
      "../../../brands/greenwick/icons/128x128@2x.png",
      "../../../brands/greenwick/icons/icon.png",
      "../../../brands/greenwick/icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "5cec51f8-f188-5692-bfc1-aff43ec5b0fc"
      }
    }
  }
}
