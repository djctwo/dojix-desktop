  "cases": [
    {
      "id": "FormattingTests.testAsCurrencyPositive",
      "line": 8,
      "subject": "Double.asCurrency",
      "kind": "format",
      "input": {
        "value": 1234.56
      },
      "expect": [
        {
          "path": "result",
          "op": "contains",
          "value": {
            "anyOf": [
              "1,234.56",
              "1234.56"
            ]
          },
          "line": 10,
          "derived": false
        },
        {
          "path": "result",
          "op": "eq",
          "value": "$1,234.56",
          "line": 8,
          "derived": true
        }
      ],
      "parity": "match",
      "notes": "asCurrency uses a NumberFormatter (currency, USD, 2 fraction digits) with the process locale; the test only checks substrings so it passes in any locale. Derived values assume en_US. op contains with anyOf: the result contains at least one of the strings."
    },
