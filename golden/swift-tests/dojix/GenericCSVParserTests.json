        {
          "path": "sampleRows.count",
          "op": "eq",
          "value": 1,
          "line": 8,
          "derived": true
        },
        {
          "path": "mapping.dateFormat",
          "op": "eq",
          "value": "yyyy.MM.dd HH:mm:ss",
          "line": 8,
          "derived": true
        },
        {
          "path": "mapping.closePrice",
          "op": "nil",
          "line": 8,
          "derived": true
        }
      ],
      "parity": "match",
      "notes": "MT4 detection: header set contains ticket, type, item and profit. With a single \"Price\" column and no \"Close Price\" the mapping has no close-price column (closePrice falls back to the open price on parse). platform values are GenericCSVParser.Platform case names (mt4 = \"MetaTrader 4\", cTrader, oanda, tradingView, ninjaTrader, strategyAnalytics, generic)."
