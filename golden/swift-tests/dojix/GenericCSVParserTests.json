      },
      "expect": [
        {
          "path": "platform",
          "op": "eq",
          "value": "mt4",
          "line": 15,
          "derived": false
        },
        {
          "path": "mapping",
          "op": "notNil",
          "line": 16,
          "derived": false
        },
        {
          "path": "mapping.platform",
          "op": "eq",
          "value": "mt4",
          "line": 17,
          "derived": false
        },
        {
          "path": "headers.count",
          "op": "eq",
          "value": 12,
          "line": 8,
          "derived": true
