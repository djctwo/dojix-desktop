          "op": "eq",
          "value": "'=1+2",
          "line": 42,
          "derived": false
        },
        {
          "path": "[2]",
          "op": "eq",
          "value": "-12.50",
          "line": 43,
          "derived": false
        },
        {
          "path": "[3]",
          "op": "eq",
          "value": "\"a,b\"",
          "line": 44,
          "derived": false
        },
        {
          "path": "[4]",
          "op": "eq",
          "value": "'=cmd",
          "line": 46,
          "derived": false
        },
        {
          "path": "[0]",
          "op": "eq",
          "value": "\"EURUSD=HYPERLINK(\"\"http://x\"\",\"\"y\"\")\"",
          "line": 38,
          "derived": true
        }
      ],
      "parity": "match",
      "notes": "Path [i] = sanitizeCSVField(fields[i]). Steps: remove control characters; prefix \"'\" when the first character is one of = + @ - and Swift Double(value) fails to parse; quote (doubling quotes) when the value contains , \" LF or CR. PARITY TRAP: Swift Double(String) also accepts \"inf\", \"-inf\", \"nan\", \"-infinity\", hex floats etc., so e.g. \"-inf\" is NOT prefixed on the Mac."
    }
