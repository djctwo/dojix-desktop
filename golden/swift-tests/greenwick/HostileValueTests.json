    {
      "id": "HostileValueTests.testSaturatingConversionNeverTraps",
      "line": 24,
      "subject": "Int.init(saturating:)",
      "kind": "sanitize",
      "input": {
        "values": [
          "NaN",
          "Infinity",
          "-Infinity",
          1e+21,
          -1e+21,
          9223372036854776000,
          42.9,
          -42.9
        ]
      },
      "expect": [
        {
          "path": "Int(saturating: NaN)",
          "op": "eq",
          "value": 0,
          "line": 25,
          "derived": false
        },
        {
          "path": "Int(saturating: Infinity)",
          "op": "eq",
          "value": "9223372036854775807",
          "line": 26,
          "derived": false
        },
        {
          "path": "Int(saturating: -Infinity)",
          "op": "eq",
          "value": "-9223372036854775808",
          "line": 27,
          "derived": false
        },
        {
          "path": "Int(saturating: 1e21)",
          "op": "eq",
          "value": "9223372036854775807",
          "line": 28,
          "derived": false
        },
        {
          "path": "Int(saturating: -1e21)",
          "op": "eq",
          "value": "-9223372036854775808",
          "line": 29,
          "derived": false
        },
        {
          "path": "Int(saturating: 9223372036854775807.0)",
          "op": "eq",
          "value": "9223372036854775807",
          "line": 30,
          "derived": false
        },
        {
          "path": "Int(saturating: 42.9)",
          "op": "eq",
          "value": 42,
          "line": 31,
          "derived": false
        },
        {
          "path": "Int(saturating: -42.9)",
          "op": "eq",
          "value": -42,
          "line": 32,
          "derived": false
        }
      ],
      "parity": "match",
      "notes": "Int.max / Int.min as strings (beyond 2^53). 9223372036854775807.0 rounds to 2^63 as a Double, so it saturates to Int.max. Truncates toward zero."
    },
