        {
          "path": "exportText",
          "op": "notContains",
          "value": "\r",
          "line": 134,
          "derived": false
        },
        {
          "path": "exportText.split(\"\\n\").count",
          "op": "eq",
          "value": 2,
          "line": 135,
          "derived": false
        },
        {
          "path": "exportText.lines[*].cells[*] (parsed with GenericCSVParser.parseCSVLine)",
          "op": "notContains",
          "value": "leading \"=\"",
          "line": 138,
          "derived": false
        },
        {
          "path": "sanitizeCSVField(\"a\\u0000b\\u001Bc\")",
          "op": "eq",
          "value": "abc",
          "line": 142,
          "derived": false
        },
        {
          "path": "sanitizeCSVField(\"\\r-cmd\")",
          "op": "eq",
          "value": "'-cmd",
          "line": 143,
          "derived": false
        }
      ],
      "parity": "match",
      "notes": "Order: strip control chars first, then prefix =\"+@-\\t\\r with a single quote, then quote fields with , \" \\n \\r. So \"\\r-cmd\" -> \"-cmd\" -> \"'-cmd\". Export = header line + one row, no trailing newline (split count 2). Desktop appends extra columns (PARITY B2) but the row count is the same. The \"leading =\" expect is XCTAssertFalse(cell.hasPrefix(\"=\")) per cell."
    },
