          },
          "line": 98,
          "derived": false
        },
        {
          "path": "set(parse1(\"TestData/robinhood_sample.csv\").trades[].ticket)",
          "op": "eq",
          "value": {
            "ref": "set(parse2(\"TestData/robinhood_sample.csv\").trades[].ticket)"
          },
          "line": 101,
          "derived": false
        },
        {
          "path": "parse1(\"TestData/thinkorswim_sample.csv\").trades[0].ticket",
          "op": "eq",
          "value": "7346775743911778085",
          "line": 98,
          "derived": true
        },
        {
          "path": "parse1(\"TestData/thinkorswim_sample.csv\").trades[1].ticket",
          "op": "eq",
          "value": "9050045187381925591",
          "line": 98,
          "derived": true
        },
        {
          "path": "parse1(\"TestData/thinkorswim_sample.csv\").trades[2].ticket",
