    {
      "id": "ImportParserTests.testReimportLaterGivesSameTickets",
      "line": 104,
      "subject": "TicketKeyCounter.ticket",
      "kind": "ticket",
      "input": {
        "files": [
          "TestData/webull_sample.csv",
          "TestData/thinkorswim_sample.csv"
        ],
        "sleep_seconds": 1.2,
        "sequence": [
          "webull",
          "sleep 1.2 s",
          "thinkorswim",
          "webull",
          "thinkorswim"
        ]
      },
      "expect": [
        {
          "path": "webull#1.trades[].ticket",
          "op": "eq",
          "value": {
            "ref": "webull#2.trades[].ticket"
          },
          "line": 110,
          "derived": false
        },
        {
          "path": "thinkorswim#1.trades[].ticket",
          "op": "eq",
          "value": {
            "ref": "thinkorswim#2.trades[].ticket"
          },
          "line": 112,
          "derived": false
        }
      ],
      "parity": "match",
      "notes": "Tickets are content hashes, never clock-based. Webull's Order Number column is ignored for the ticket (SPEC §5.1)."
    },
    {
      "id": "ImportParserTests.testDifferentFilesWithSameTradeNumbersDoNotCollide",
      "line": 115,
      "subject": "TicketKeyCounter.ticket",
      "kind": "ticket",
      "input": {
        "helper": "parse",
        "a": {
          "csv": "Trade #,Instrument,Market Position,Quantity,Entry Time,Exit Time,Entry Price,Exit Price,Profit\n1,AAPL,Long,10,03/24/2026 09:35:00,03/24/2026 10:15:00,100,101,10",
          "platform": "NinjaTrader"
        },
        "b": {
          "csv": "Trade #,Instrument,Market Position,Quantity,Entry Time,Exit Time,Entry Price,Exit Price,Profit\n1,MSFT,Long,10,03/25/2026 09:35:00,03/25/2026 10:15:00,200,201,10",
          "platform": "NinjaTrader"
        }
      },
      "expect": [
        {
          "path": "a.trades[0].ticket == b.trades[0].ticket",
          "op": "false",
          "value": null,
          "line": 121,
          "derived": false
        },
        {
          "path": "a.trades[0].ticket",
          "op": "eq",
          "value": "308530286678055712",
          "line": 121,
          "derived": true
        },
        {
          "path": "b.trades[0].ticket",
          "op": "eq",
          "value": "748717176594918684",
          "line": 121,
          "derived": true
        }
      ],
      "parity": "match",
      "notes": "XCTAssertNotEqual recorded as (a == b) false. NinjaTrader \"Trade #\" is ignored: both files start at 1. Derived tickets per SPEC §5.1 (FNV-1a key \"NinjaTrader|<fields>#0\")."
    },
