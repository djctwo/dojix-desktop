    {
      "id": "ImportSecurityTests.testMalformedLinesDoNotCrash",
      "line": 52,
      "subject": "GenericCSVParser.parse",
      "kind": "sanitize",
      "input": {
        "helper": "importAll",
        "platform": "Thinkorswim",
        "header": "Exec Time,Symbol,Side,Qty,Price,Net Price,P/L,Commission",
        "rows": [
          "\"unterminated,quote,field",
          ",,,,,,,",
          "03/24/26 09:31:15,=HYPERLINK(\"http://example.invalid\"),BUY,1,1,1,1,1",
          {
            "repeat": "A",
            "count": 200000
          },
          "03/24/26 09:31:15,AAPL,SIDEWAYS,100,171.25,171.30,25.00,0.65",
          "not a date,AAPL,BUY,100,171.25,171.30,25.00,0.65",
          "\u0000�‮garbage,💩,BUY,1,1,1,1,1"
        ],
        "csv_rule": "header + rows joined by \"\\n\", no trailing newline; {repeat, count} = that character repeated count times"
      },
      "expect": [
        {
          "path": "trades[*].symbol chars",
          "op": "true",
          "value": "letter (Unicode isLetter) | number (isNumber) | \".\"",
          "line": 64,
          "derived": false
        },
        {
          "path": "trades[*].symbol.count",
          "op": "le",
          "value": 10,
          "line": 65,
          "derived": false
        }
      ],
      "parity": "match",
      "notes": "Import cleanSymbol: uppercased, keeps only Character.isLetter/isNumber/\".\", truncated to 10 chars (TradeLimits allows 32; import is stricter). Only the =HYPERLINK row survives, as symbol \"HYPERLINKH\" (not asserted). Swift isLetter is Unicode-wide: JS needs \\p{L}/\\p{N}, not [A-Z0-9]."
    },
