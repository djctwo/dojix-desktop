    {
      "id": "ImportSecurityTests.testLargeValidFileParsesInReasonableTime",
      "line": 98,
      "subject": "GenericCSVParser.parse",
      "kind": "import",
      "input": {
        "helper": "importAll",
        "platform": "Thinkorswim",
        "header": "Exec Time,Symbol,Side,Qty,Price,Net Price,P/L,Commission",
        "generator": {
          "count": 20000,
          "format": "03/24/26 %02d:%02d:%02d,SYM%d,BUY,10,100.00,100.00,%d.00,0.10",
          "args": [
            "hour = 9 + (i / 60) % 7",
            "minute = i % 60",
            "second = i % 60",
            "i % 50",
            "(i % 7) - 3"
          ]
        },
        "csv_rule": "header + 20000 rows joined by \"\\n\", no trailing newline"
      },
      "expect": [
        {
          "path": "trades.count",
          "op": "eq",
          "value": 20000,
          "line": 109,
          "derived": false
        },
        {
          "path": "elapsedSeconds",
          "op": "lt",
          "value": 60,
          "line": 110,
          "derived": false
        },
        {
          "path": "sum(trades[].netProfit)",
          "op": "approx",
          "value": -2003,
          "accuracy": 0.01,
          "line": 109,
          "derived": true
        }
      ],
      "parity": "match",
      "notes": "Rows repeat every 2100 lines; the occurrence counter keeps every duplicate. Derived: sum((i%7)-3) over i<20000 = -3, minus 20000 x |0.10| commission = -2003 (net of costs, SPEC §3.1). \"%d.00\" of a negative int gives \"-3.00\"."
    },
