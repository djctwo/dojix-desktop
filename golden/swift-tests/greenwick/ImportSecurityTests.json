    {
      "id": "ImportSecurityTests.testNonFiniteAndAbsurdNumbersAreRejected",
      "line": 23,
      "subject": "GenericCSVParser.parse",
      "kind": "validation",
      "input": {
        "helper": "importAll",
        "platform": "Thinkorswim",
        "csv": "Exec Time,Symbol,Side,Qty,Price,Net Price,P/L,Commission\n03/24/26 09:31:15,AAPL,BUY,inf,171.25,171.30,25.00,0.65\n03/24/26 09:32:15,AAPL,BUY,nan,171.25,171.30,25.00,0.65\n03/24/26 09:33:15,AAPL,BUY,1e308,171.25,171.30,25.00,0.65\n03/24/26 09:34:15,AAPL,BUY,-0,171.25,171.30,25.00,0.65\n03/24/26 09:35:15,AAPL,BUY,100,171.25,171.30,1e300,0.65\n03/24/26 09:36:15,AAPL,BUY,100,171.25,171.30,25.00,0.65"
      },
      "expect": [
        {
          "path": "trades[*].shares",
          "op": "gt",
          "value": 0,
          "line": 34,
          "derived": false
        },
        {
          "path": "trades[*].shares",
          "op": "le",
          "value": 1000000000,
          "line": 34,
          "derived": false
        },
        {
          "path": "trades[*].netProfit (isNaN)",
          "op": "false",
          "value": null,
          "line": 35,
          "derived": false
        },
        {
          "path": "trades[*].netProfit (abs)",
          "op": "le",
          "value": "1000000000000",
          "line": 36,
          "derived": false
        },
        {
          "path": "trades.count",
          "op": "eq",
          "value": 2,
          "line": 39,
          "derived": false
        }
      ],
      "parity": "match",
      "notes": "Rows 1-4 rejected (inf, nan, 1e308 > 1e9, -0 -> 0 < 1e-6). Row 5 is KEPT: an out-of-range P&L (1e300 > 1e12) parses as nil -> profit 0, so its stored net is 0 - |0.65| = -0.65 (the test comment says \"P&L 0\"; the value is not asserted). MetricsCalculator.calculate must not trap."
    },
