      "id": "RestoreValidationTests.testOlderBackupIsMigratedAfterValidation",
      "line": 154,
      "subject": "BackupService.restore",
      "kind": "sample",
      "input": {
        "helper": "backupBytes",
        "live": {
          "helper": "makeLiveJournal"
        },
        "trades": [
          {
            "helper": "sampleTrades"
          },
          {
            "base": "sampleTrades()[0]",
            "ticket": 123,
            "isSample": false,
            "comment": "Demo"
          }
        ],
        "sql": [
          "DROP TABLE settings",
          "ALTER TABLE trades DROP COLUMN isSample",
          "UPDATE trades SET comment = 'Demo'",
          "DELETE FROM grdb_migrations WHERE identifier IN ('v4_createSettings', 'v5_markSampleTrades')"
        ]
      },
      "expect": [
        {
          "path": "live.count()",
          "op": "eq",
          "value": 31,
          "line": 170,
          "derived": false
        },
        {
