    {
      "id": "SecurityReviewTests.testHostilePropFirmValuesFallBackToDefaults",
      "line": 79,
      "subject": "PropFirmSettings.load",
      "kind": "validation",
      "input": {
        "settings_keys": [
          "propFirm_accountSize",
          "propFirm_profitTarget",
          "propFirm_maxDailyLoss",
          "propFirm_maxTotalDrawdown"
        ],
        "stored_text_values": [
          "nan",
          "inf",
          "-5",
          "1e300",
          "abc",
          "0"
        ],
        "saved": {
          "accountSize": "Infinity",
          "profitTarget": 500,
          "maxDailyLoss": -1,
          "maxTotalDrawdown": "NaN"
        }
      },
      "expect": [
        {
          "path": "load() after each stored_text_values[*] in all 4 keys",
          "op": "eq",
          "value": {
            "accountSize": 100000,
            "profitTarget": 8,
            "maxDailyLoss": 5,
            "maxTotalDrawdown": 10
          },
          "line": 88,
          "derived": false
        },
        {
          "path": "load() after save(saved)",
          "op": "eq",
          "value": {
            "accountSize": 100000,
            "profitTarget": 8,
            "maxDailyLoss": 5,
            "maxTotalDrawdown": 10
          },
          "line": 92,
          "derived": false
        }
      ],
      "parity": "match",
      "notes": "A value is kept only if finite, > 0 and <= max (accountSize <= 1e12; percentages <= 100); otherwise that field falls back to its default. Defaults: 100000 / 8 / 5 / 10. Infinity/NaN written as strings (JSON). Prop-firm settings live in the encrypted journal settings table."
    },
    {
