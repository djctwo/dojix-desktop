{
  "app": "greenwick",
  "source_repo": "djctwo/greenwick",
  "source_sha": "64495e28b0c9a8016ea86adf43098a569307e074",
  "file": "GreenwickTests/TradingDayTests.swift",
  "helpers": {
    "et": {
      "line": 27,
      "defaults": {
        "tz": "America/New_York",
        "calendar": "gregorian"
      },
      "notes": "Builds an instant from New York wall-clock year/month/day/hour/minute. All such instants are written below as UTC ISO-8601."
    },
    "inEachZone": {
      "line": 34,
      "defaults": {
        "zones": [
          "Europe/Berlin",
          "Asia/Tokyo",
          "America/Los_Angeles"
        ]
      },
      "notes": "Runs the body once per zone with NSTimeZone.default (Calendar.current, DateFormatter) switched to that zone; every expect must hold in every zone. Desktop: run with each zone as the display/local zone; Greenwick results must not change."
    },
    "trade": {
      "line": 45,
      "defaults": {
        "ticket": "random 1...Int64.max",
        "symbol": "AAPL",
        "direction": "BUY",
        "shares": 100,
        "openPrice": "100",
        "closePrice": "101",
        "sl": "0",
        "tp": "0",
        "maePoints": 0,
        "mfePoints": 0,
        "rMultiple": 0,
        "rangeSize": 0,
        "hitBreakeven": false,
        "scaledIn": false,
        "comment": "",
        "timeToMFEMin": 0,
        "slDistPoints": 0,
        "slippagePoints": 0,
        "importedAt": "Date() (now)",
        "durationMin": "Int((closeTime - openTime) / 60)",
        "session": "openTime.marketSession (ET)",
        "dayOfWeek": "openTime.shortDayName (ET) unless given",
        "hour": "openTime.etHour"
      },
      "notes": "A trade built the way the importers build one. Cases list only openTime, closeTime, netProfit (and dayOfWeek when overridden)."
    },
    "importNinjaTrader": {
      "line": 60,
      "defaults": {
        "header": "Trade #,Instrument,Market Position,Quantity,Entry Time,Exit Time,Entry Price,Exit Price,Profit,MAE,MFE,Commission",
        "rowSeparator": "\n",
        "trailingNewline": true,
        "platform": "NinjaTrader"
      },
      "notes": "Writes header + rows to a temp .csv and runs GenericCSVParser.detect + parse. The csv in each case is the exact file text. File times are New York time."
    },
    "calendarCell": {
      "line": 73,
      "defaults": {
        "firstWeekday": 1,
        "locale": "en_US_POSIX"
      },
      "notes": "P&L calendar cell: grid = TradeCalendar.gridCalendar(firstWeekday, en_US_POSIX) (TradingCalendar.calendar = America/New_York); days = TradeCalendar.days(inMonthOf:); pnl = TradeCalendar.dailyPnL(for: trades)[grid.startOfDay(days[day-1])] (nil = empty cell); header = weekdayHeaders[(leadingBlankCount + day - 1) % 7]. Path cell[N] = day-of-month N of the month containing the given instant (in ET)."
    }
  },
  "cases": [
    {
      "id": "TradingDayTests.testFridayAfterHoursTradeIsOnFridayInPnLCalendar",
      "line": 85,
      "subject": "TradeCalendar.dailyPnL",
      "kind": "calendar",
      "input": {
        "helper": "importNinjaTrader",
        "tz": [
          "Europe/Berlin",
          "Asia/Tokyo",
          "America/Los_Angeles"
        ],
        "platform": "NinjaTrader",
        "csv": "Trade #,Instrument,Market Position,Quantity,Entry Time,Exit Time,Entry Price,Exit Price,Profit,MAE,MFE,Commission\n1,AAPL,Long,100,10/23/2026 10:00:00,10/23/2026 10:30:00,171.00,171.50,50.00,0.10,0.60,0.00\n2,TSLA,Long,100,10/23/2026 18:20:00,10/23/2026 18:50:00,180.00,181.25,125.00,0.10,1.50,0.00\n",
        "firstWeekday": [
          1,
          2
        ],
        "month_of": "trades[0].closeTime"
      },
      "expect": [
        {
          "path": "trades.count",
          "op": "eq",
          "value": 2,
          "line": 91,
          "derived": false
        },
        {
          "path": "cell[23].pnl",
          "op": "approx",
          "value": 175,
          "accuracy": 0.001,
          "line": 95,
          "derived": false
        },
        {
          "path": "cell[23].header",
          "op": "eq",
          "value": "Fri",
          "line": 96,
          "derived": false
        },
        {
          "path": "cell[24].pnl",
          "op": "nil",
          "value": null,
          "line": 98,
          "derived": false
        },
        {
          "path": "TradeCalendar.monthTitle(TradeCalendar.days(inMonthOf: trades[0].closeTime, calendar: gridCalendar())[0], locale: en_US_POSIX)",
          "op": "eq",
          "value": "October 2026",
          "line": 101,
          "derived": false
        },
        {
          "path": "trades[0].openTime",
          "op": "eq",
          "value": "2026-10-23T14:00:00Z",
          "line": 91,
          "derived": true
        },
        {
          "path": "trades[1].closeTime",
          "op": "eq",
          "value": "2026-10-23T22:50:00Z",
          "line": 91,
          "derived": true
        }
      ],
      "parity": "match",
      "notes": "cell asserts run for firstWeekday 1 (Sunday-first) and 2 (Monday-first) in every zone. Derived times: NinjaTrader times are New York time (SPEC §3.1). Fri 23 Oct 18:50 ET = Sat 00:50 Berlin / 07:50 Tokyo."
    },
